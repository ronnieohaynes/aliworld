# public config lives in committed .env. put any REAL secrets in .env.local
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# analytics admin dashboard, password entered at /admin, stored in sessionStorage only.
# Set the matching secret in Supabase (never commit the real value):
# ANALYTICS_ADMIN_SECRET=your-chosen-admin-password

# Supabase edge function secrets (Dashboard → Edge Functions → analytics-summary → Secrets)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  (auto-injected in some setups; set if missing)
