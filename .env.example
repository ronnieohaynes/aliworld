# public config lives in committed .env. put any REAL secrets in .env.local
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# analytics admin dashboard (npm run admin:dev) — NEVER commit real values
# VITE_ANALYTICS_ADMIN_SECRET=shared-secret-for-ui-gate-and-edge-function-header

# Supabase edge function secrets (Dashboard → Edge Functions → analytics-summary → Secrets)
# ANALYTICS_ADMIN_SECRET=same-value-as-VITE_ANALYTICS_ADMIN_SECRET
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  (auto-injected in some setups; set if missing)
